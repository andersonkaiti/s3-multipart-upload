{
  "name": "s3-multipart-uploads",
  "type": "module",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "commitlint-config-gitmoji": "^2.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "scripts": {
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional",
      "gitmoji"
    ],
    "rules": {
      "scope-empty": [
        2,
        "never"
      ]
    }
  },
  "lint-staged": {
    "**/*.{ts,json,tsx}": [
      "biome check --write"
    ]
  }
}
